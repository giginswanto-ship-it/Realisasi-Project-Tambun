# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tambun_db?schema=public"

# Authentication (JWT)
JWT_SECRET=super-secret-jwt-key-for-tambun-monitoring-system-2026
JWT_EXPIRATION=1d

# S3 Compatible Storage (MinIO / Supabase / AWS S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=tambun-receipts
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# Approval Threshold
DIRECTOR_THRESHOLD_AMOUNT=25000000
